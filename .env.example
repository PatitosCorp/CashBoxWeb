# Copy to .env.local. `npx supabase start` prints the local values.
# Only the anon (publishable) key goes here; never the service_role key.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=
# Cloudflare Turnstile site key. Enable CAPTCHA in Supabase (Auth > Attack Protection) with the matching secret.
VITE_TURNSTILE_SITE_KEY=
